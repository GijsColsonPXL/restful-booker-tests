    {
      "name": "US3 - Authenticatie",
      "item": [
        {
          "name": "Auth - admin geldige login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"Response bevat een token\", function () {",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "// token bewaren voor PUT/PATCH/DELETE",
                  "if (json.token) { pm.collectionVariables.set(\"token\", json.token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
