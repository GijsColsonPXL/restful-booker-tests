                  "});",
                  "pm.test(\"Boeking bevat alle velden\", function () {",
                  "    const b = pm.response.json();",
                  "    pm.expect(b).to.include.all.keys(\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\");",
                  "    pm.expect(b.bookingdates).to.include.all.keys(\"checkin\", \"checkout\");",
                  "});",
                  "pm.test(\"Response time < 5000 ms (incl. ~3 s ingebouwde vertraging)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ]
